{
  // Mặc định使用的 provider、model 和Cường độ suy luận。
  // ★ Giá trị provider là một key trong providers bên dưới (một “con trỏ”), không phải tên giao thức —
  //   Khi đổi provider phải bảo đảm providers có mục cùng tên, nếu không khởi động sẽ báo “chưa cấu hình thông tin xác thực”.
  //   Khi chạy, dùng /config để quản lý Provider/kho mô hình, dùng /model để chuyển giữa các mô hình đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // 可选。Mặc địnhCường độ suy luận：off / low / medium / high / xhigh / max。
  // 省略或空字符串 = 不覆盖，沿用模型/provider Mặc định。
  "reasoning_effort": "medium",

  // Provider 凭证库。key Tùy chỉnh，用作上面 provider 字段引用的目标。
  // Provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // 可省略 type；Tùy chỉnh代理必须显式声明 type 指明 API 协议。
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo các lựa chọn trong bảng /model và cửa sổ ngữ cảnh riêng của mô hình; mảng chuỗi kiểu cũ vẫn tương thích.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Tham số bổ sung truyền thẳng vào mỗi request của provider này (tham số sampling như temperature/top_p/
      // min_p, hoặc khóa riêng của hãng như chat_template_kwargs để bật thinking trên nvidia), được nhập nguyên văn vào request body.
      // Chỉ có hiệu lực với provider tương thích OpenAI (openrouter/deepseek/qwen/glm/grok/ollama…);
      // type:"openai" sẽ lọc theo whitelist tham số chính thức. Người dùng tự chịu trách nhiệm về giá trị.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền thẳng tới tầng HTTP client (không phải request body), dùng khi cần
      // Tùy chỉnh User-Agent / headers / anthropic_beta 的代理。
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4" }, { "name": "claude-opus-4" }]
    },
    "ollama": {
      // ollama / bedrock / 显式 type 的Tùy chỉnh代理可以省略 api_key
      // base_url 需带 /v1（ollama 的 OpenAI 兼容端点在 /v1 下）
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // 可选。流式空闲看门狗（Go duration，Mặc định "5m"）：LocalAI/ollama 等
      // 本地慢推理首块可超 5 分钟，按 provider 放宽，不影响其它通道
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Tùy chỉnh Anthropic 代理。如果上游限制只能由 Claude Code 客户端访问，
      // 用 extra 透传 user_agent / anthropic_beta / headers。
      // base_url không cần kèm /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Tùy chỉnh OpenAI/NewAPI 代理。如果上游限制只能由 Codex 客户端访问，
      // 用 extra 覆盖 User-Agent，并透传 Codex 识别头。
      // base_url điền theo địa chỉ thực tế của proxy; giao thức OpenAI thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000 },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // 可选。OpenAI 协议 endpoint：chat（Mặc định /v1/chat/completions）/
      // responses（/v1/responses）。Codex 类代理通常需要 responses。
      "api": "responses",
      "extra": {
        // 可选。Cache路由键 prompt_cache_key Mặc định只发给官方 api.openai.com——
        // 第三方兼容端对未知字段没有统一契约（Groq/Cerebras/火山等严格端会 400，
        // 重编组型Trung bình转会静默丢弃）。确认你的Trung bình转原样透传请求体到 OpenAI 时，
        // 打开此项可获得Cache路由亲和（提升命Trung bình率）。
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // 可选。按Vai trò覆盖Mặc định模型；未配的Vai trò使用上面的 model。
  // reasoning_effort 也可按Vai trò覆盖；未配时继承顶层 reasoning_effort。
  // Vai trò：architect / writer / editor。fallbacks 在主模型失败时按序尝试。
  // Lưu ý: provider ở đây cũng là “con trỏ”, phải trỏ tới key tồn tại trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Phong cách viết: default / suspense / fantasy / romance.
  "style": "default"

  // 旧版全局上下文窗口，保留作所有模型的回退。优先级Thấp于 models[].context_window，
  // Cao于模型注册表和 200k Mặc định值。仅影响压缩阈值，不改变 API 实际请求长度。
  // "context_window": 300000

  // 可选。单本书（output 目录）的成本Ngân sách，挂机保险丝。book_usd > 0 才启用。
  // 累计花费达到 warn_ratio 时告警不停机；达到 100% 在Hiện tại子代理任务结束后
  // 优雅停机（hard_stop=true 则越线立即停）。停机后上调 book_usd 即可恢复续跑。
  // 注意：Tùy chỉnh模型若注册表查不到价格且 provider 不自报 cost，Ngân sách形同虚设。
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // 可选。无人值守告警，缺省启用（Windows 通知 / macOS osascript / Linux notify-send）。
  // 配置 command 后改走Tùy chỉnh命令（手机推送走这里）：字段经环境变量
  // NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL 通过环境变量传入，完整 JSON 同时写 stdin。
  // Unix shell 用 $NOTIFY_TITLE；Windows PowerShell 用 $env:NOTIFY_TITLE。
  // events 可选过滤：run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure；缺省全部开启。
  // "notify": {
  //   "enabled": true,
  //   // 标题/正文含Trung bình文与空格，必须经 --data-urlencode 传参，不可拼进 URL 路径或 HTTP 头。
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
