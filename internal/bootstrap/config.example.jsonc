{
  // Nhà cung cấp, model và mức suy luận mặc định.
  // ★ Giá trị provider là một key trong providers bên dưới (một “con trỏ”), không phải tên giao thức —
  //   Khi đổi provider phải bảo đảm providers có mục cùng tên, nếu không khởi động sẽ báo “chưa cấu hình thông tin xác thực”.
  //   Khi chạy, dùng /config để quản lý Provider/kho mô hình, dùng /model để chuyển giữa các mô hình đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Mức suy luận mặc định: off / low / medium / high / xhigh / max.
  // Bỏ qua hoặc để chuỗi rỗng = không ghi đè, giữ nguyên mặc định của model/provider.
  "reasoning_effort": "medium",

  // Kho thông tin xác thực của provider. Key tùy chỉnh, dùng làm đích tham chiếu cho trường provider ở trên.
  // Provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // Có thể bỏ qua type; proxy tùy chỉnh phải khai báo rõ type để chỉ định giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo các model hiển thị trong /model và cửa sổ ngữ cảnh riêng của từng model; mảng chuỗi kiểu cũ vẫn tương thích.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Tham số bổ sung truyền thẳng vào mỗi request của provider này (như temperature/top_p/
      // min_p, hoặc khóa riêng của hãng như chat_template_kwargs để bật thinking trên nvidia); nội dung được ghi nguyên văn vào request body.
      // Chỉ có hiệu lực với provider tương thích OpenAI (openrouter/deepseek/qwen/glm/grok/ollama…);
      // type:"openai" sẽ lọc theo whitelist tham số chính thức. Người dùng tự chịu trách nhiệm với giá trị.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền thẳng tới tầng HTTP client (không phải request body), dùng khi cần
      // chỉnh User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4" }, { "name": "claude-opus-4" }]
    },
    "ollama": {
      // Với ollama / bedrock / proxy tùy chỉnh có khai báo type rõ ràng, có thể bỏ qua api_key
      // base_url phải kèm /v1 (endpoint tương thích OpenAI của ollama nằm dưới /v1)
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Bộ đếm thời gian chờ khi stream không có dữ liệu (Go duration, mặc định "5m"): LocalAI/ollama, v.v.
      // Với suy luận chậm cục bộ, phần đầu tiên có thể chờ quá 5 phút; nới theo provider này, không ảnh hưởng các kênh khác
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Proxy Anthropic tùy chỉnh. Nếu upstream chỉ cho phép truy cập từ Claude Code client,
      // dùng extra để truyền tiếp user_agent / anthropic_beta / headers.
      // base_url không cần kèm /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Proxy OpenAI/NewAPI tùy chỉnh. Nếu upstream chỉ cho phép truy cập từ Codex client,
      // dùng extra để ghi đè User-Agent và truyền tiếp các header nhận diện Codex.
      // base_url điền theo địa chỉ thực tế của proxy; giao thức OpenAI thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000 },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. Endpoint theo giao thức OpenAI: chat (mặc định /v1/chat/completions)/
      // responses (/v1/responses). Proxy kiểu Codex thường cần responses.
      "api": "responses",
      "extra": {
        // Tùy chọn. prompt_cache_key mặc định chỉ nên gửi tới api.openai.com chính thức —
        // nhiều endpoint tương thích bên thứ ba không thống nhất với trường lạ (Groq/Cerebras/Volcano, v.v. có thể trả 400).
        // Chỉ bật khi bạn chắc proxy chuyển nguyên request body sang OpenAI; khi đó cache routing sẽ thân thiện hơn (tăng cache hit).
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model mặc định theo vai trò; vai trò không cấu hình sẽ dùng model ở trên.
  // reasoning_effort cũng có thể ghi đè theo vai trò; nếu không cấu hình sẽ kế thừa reasoning_effort cấp trên.
  // Vai trò: architect / writer / editor. Các phương án dự phòng sẽ được thử theo thứ tự khi model chính thất bại.
  // Lưu ý: provider ở đây cũng là “con trỏ”, phải trỏ tới key tồn tại trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Phong cách viết: default / suspense / fantasy / romance.
  "style": "default"

  // Cửa sổ ngữ cảnh toàn cục kiểu cũ, giữ lại làm phương án dự phòng cho mọi model. Ưu tiên thấp hơn models[].context_window,
  // cao hơn bảng đăng ký model và giá trị mặc định 200k. Chỉ ảnh hưởng ngưỡng nén, không đổi độ dài request thực tế gửi tới API.
  // "context_window": 300000

  // Tùy chọn. Ngân sách chi phí cho một đầu sách (thư mục output), cơ chế chặn chạy lố. Chỉ bật khi book_usd > 0.
  // Khi chi tiêu tích lũy đạt warn_ratio thì cảnh báo nhưng không dừng; khi đạt 100% thì sau khi tác vụ agent con hiện tại kết thúc
  // sẽ dừng nhẹ nhàng (hard_stop=true thì vượt ngưỡng sẽ dừng ngay). Sau khi dừng, chỉ cần tăng book_usd là chạy tiếp được.
  // Lưu ý: nếu model tùy chỉnh không có giá trong registry và provider không tự báo cost, ngân sách sẽ gần như vô hiệu.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Thông báo cho chế độ chạy tự động, mặc định bật (Windows notification / macOS osascript / Linux notify-send).
  // Khi cấu hình command thì chuyển sang lệnh tùy chỉnh (cũng dùng cho đẩy thông báo lên điện thoại): các trường được truyền qua biến môi trường
  // NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL, đồng thời JSON đầy đủ được ghi vào stdin.
  // Unix shell dùng $NOTIFY_TITLE; Windows PowerShell dùng $env:NOTIFY_TITLE.
  // events có thể lọc tùy chọn: run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure; mặc định bật tất cả.
  // "notify": {
  //   "enabled": true,
  //   // Văn bản có chữ tiếng Trung và dấu cách phải truyền qua --data-urlencode, không được ghép vào đường dẫn URL hay HTTP header.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
